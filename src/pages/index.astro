---
import Base from '../layouts/Base.astro'
const user = Astro.locals.user
---

<Base title="Astralia">
  <main class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Hero section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4">Astralia</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">
        Tu carta natal, interpretaciones y más
      </p>

      {
        user ? (
          <div class="mt-6">
            <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">
              Bienvenido de vuelta, {user.name || user.email}
            </p>
            <a
              href="/dashboard"
              class="inline-block px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors"
            >
              Ir al Dashboard
            </a>
          </div>
        ) : (
          <div class="mt-6 flex gap-4 justify-center">
            <a
              href="/signin"
              class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors"
            >
              Iniciar Sesión
            </a>
            <a
              href="/signup"
              class="px-6 py-3 border border-indigo-600 text-indigo-600 hover:bg-indigo-50 dark:text-indigo-400 dark:hover:bg-indigo-950 font-medium rounded-lg transition-colors"
            >
              Registrarse
            </a>
          </div>
        )
      }
    </section>
  </main>
</Base>
