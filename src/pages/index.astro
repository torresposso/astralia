---
import Base from '../layouts/Base.astro'
const user = Astro.locals.user
---

<Base title="Astralia">
  <main class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Hero section -->
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4">Astralia</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">
        Tu carta natal, interpretaciones y más
      </p>

      {
        user ? (
          <div class="mt-6">
            <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">
              Bienvenido de vuelta, {user.name || user.email}
            </p>
            <a
              href="/dashboard"
              class="inline-block px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors"
            >
              Ir al Dashboard
            </a>
          </div>
        ) : (
          <div class="mt-6 flex gap-4 justify-center">
            <a
              href="/signin"
              class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors"
            >
              Iniciar Sesión
            </a>
            <a
              href="/signup"
              class="px-6 py-3 border border-indigo-600 text-indigo-600 hover:bg-indigo-50 dark:text-indigo-400 dark:hover:bg-indigo-950 font-medium rounded-lg transition-colors"
            >
              Registrarse
            </a>
          </div>
        )
      }
    </section>

    <!-- Alpine.js interactivity demo section -->
    <section
      class="mb-16 p-8 rounded-2xl border border-gray-200 dark:border-gray-800"
    >
      <h2 class="text-2xl font-semibold mb-6">Alpine.js demo</h2>

      <div x-data="{ count: 0 }" class="space-y-4">
        <p class="text-lg">
          Has hecho clic <strong x-text="count" class="text-2xl"></strong> veces
        </p>
        <div class="flex gap-3">
          <button
            @click="count++"
            class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            +1
          </button>
          <button
            @click="count = 0"
            class="px-5 py-2 bg-gray-200 dark:bg-gray-800 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors"
          >
            Reset
          </button>
        </div>
      </div>
    </section>

    <!-- HTMX demo section -->
    <section
      class="mb-16 p-8 rounded-2xl border border-gray-200 dark:border-gray-800"
    >
      <h2 class="text-2xl font-semibold mb-6">HTMX demo</h2>

      <div class="space-y-4">
        <button
          hx-get="/partials/hello"
          hx-target="#htmx-result"
          hx-swap="innerHTML"
          class="px-5 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors"
        >
          Cargar mensaje del servidor
        </button>

        <div
          id="htmx-result"
          class="p-4 rounded-lg bg-gray-50 dark:bg-gray-900 text-gray-600 dark:text-gray-400"
        >
          Haz clic en el botón para cargar contenido...
        </div>
      </div>
    </section>
  </main>
</Base>
