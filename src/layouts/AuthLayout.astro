---
// AuthLayout.astro — Layout centrado para páginas de autenticación
// Se usa dentro de Base.astro, no lo reemplaza

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<main class="flex items-center justify-center min-h-[calc(100vh-4rem)] px-4">
  <div class="w-full max-w-md bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
    <!-- Logo -->
    <div class="text-center mb-8">
      <a href="/" class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">
        Astralia
      </a>
      {title && (
        <h1 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mt-2">
          {title}
        </h1>
      )}
    </div>

    <slot />
  </div>
</main>
